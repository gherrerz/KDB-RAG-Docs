# API and provider placeholders
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
LLM_PROVIDER=openai
LLM_EMBEDDING=
# Timeout (s) and output-token cap for answer-provider HTTP calls.
LLM_REQUEST_TIMEOUT_SEC=120
LLM_MAX_OUTPUT_TOKENS=4096
# App decodes this at startup and keeps the JSON available in runtime.
VERTEX_SERVICE_ACCOUNT_JSON_B64=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
VERTEX_AUTH_TOKEN_URL=https://oauth2.googleapis.com/token
VERTEX_API_BASE_URL=aiplatform.googleapis.com
VERTEX_ANSWER_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_LABEL_SERVICE=webspec-coipo
VERTEX_LABEL_SERVICE_ACCOUNT=qa-anthos
# Fallback only: model_name label is resolved dynamically from
# VERTEX_ANSWER_MODEL or effective embedding model per operation.
VERTEX_LABEL_MODEL_NAME=gemini-2.5-flash
VERTEX_LABEL_USE_CASE_ID=tbd
DATA_DIR=./storage
API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8000
ADMIN_RESET_ENABLED=false
ADMIN_RESET_TOKEN=
# Servidor MCP (envoltura fastapi-mcp sobre /mcp para agentes de IA).
# MCP_ENABLED=true monta /mcp en la misma app. Defina MCP_API_TOKEN y
# autentique con header "Authorization: Bearer <MCP_API_TOKEN>" antes de
# exponerlo fuera de una red confiable (HTTP 401 si falta o no coincide).
# Si MCP_API_TOKEN queda vacío, /mcp permanece accesible sin autenticación
# (solo protegido por el flag MCP_ENABLED).
MCP_ENABLED=true
MCP_API_TOKEN=
MCP_MOUNT_PATH=/mcp
MCP_SERVER_NAME=docrag-mcp
# Descripción publicada sin autenticación en GET /info (contrato Hexa).
MCP_SERVER_DESCRIPTION=
# Optional UI overrides. Leave unset to reuse API_HOST/API_PORT.
# API_BASE_URL=http://127.0.0.1:8000
# UI_API_HOST=127.0.0.1
# UI_API_PORT=8000
REDIS_HOST_PORT=6379
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
CHROMA_HOST_PORT=8002
POSTGRES_HOST_PORT=5433
# Optional Docker Compose image overrides for local/offline validation.
# CHROMA_IMAGE=chromadb/chroma:latest
# NEO4J_IMAGE=neo4j:5.24
# REDIS_IMAGE=redis:7.4-alpine
# Entorno de ejecución activo: development | test (QA) | production.
# Decide el sufijo de las variantes de infraestructura por entorno
# (DEV/TEST/PROD) y la política de arranque de Alembic.
RUNTIME_ENVIRONMENT=development
# --- Infraestructura por entorno (servidores separados) ---
# Las URLs y credenciales de Chroma/Postgres/Neo4j pueden diferenciarse por
# entorno con variantes sufijadas. Precedencia por variable:
#   {VAR}_{SUFIJO}  ->  {VAR} (base, fallback)  ->  default
# Sufijos: development=_DEV, test=_TEST, production=_PROD.
# Solo se sufijan endpoints y credenciales de infra (NO pools, batch, LLM, etc).
# Ejemplos (descomenta y completa los del entorno que uses):
#   CHROMA_HOST_TEST=chroma-qa.internal
#   CHROMA_TOKEN_TEST=
#   POSTGRES_HOST_PROD=pg-prod.internal
#   POSTGRES_USER_PROD=          POSTGRES_PASSWORD_PROD=
#   POSTGRES_DB_PROD=coderag_docs_prod
#   NEO4J_URI_PROD=bolt://neo4j-prod.internal:7687
#   NEO4J_USER_PROD=neo4j        NEO4J_PASSWORD_PROD=
USE_NEO4J=false
# Variables base (fallback si no hay variante para el entorno activo).
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
USE_CHROMA=true
CHROMA_MODE=remote
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8002
CHROMA_PERSIST_DIR=./storage/chromadb
CHROMA_COLLECTION=coderag_chunks
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=coderag_docs
POSTGRES_USER=coderag
POSTGRES_PASSWORD=coderag
USE_RQ=false
REDIS_URL=redis://localhost:6379/0
RQ_INGEST_JOB_TIMEOUT_SEC=900
