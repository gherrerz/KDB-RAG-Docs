# API and provider placeholders
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_ANSWER_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
LLM_PROVIDER=openai
LLM_EMBEDDING=
# App decodes this at startup and keeps the JSON available in runtime.
VERTEX_SERVICE_ACCOUNT_JSON_B64=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
VERTEX_AUTH_TOKEN_URL=https://oauth2.googleapis.com/token
VERTEX_API_BASE_URL=aiplatform.googleapis.com
VERTEX_ANSWER_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_LABEL_SERVICE=webspec-coipo
VERTEX_LABEL_SERVICE_ACCOUNT=qa-anthos
# Fallback only: model_name label is resolved dynamically from
# VERTEX_ANSWER_MODEL or effective embedding model per operation.
VERTEX_LABEL_MODEL_NAME=gemini-2.5-flash
VERTEX_LABEL_USE_CASE_ID=tbd
DATA_DIR=./storage
API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8000
# Optional UI overrides. Leave unset to reuse API_HOST/API_PORT.
# API_BASE_URL=http://127.0.0.1:8000
# UI_API_HOST=127.0.0.1
# UI_API_PORT=8000
REDIS_HOST_PORT=6379
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
CHROMA_HOST_PORT=8002
POSTGRES_HOST_PORT=5433
# Optional Docker Compose image overrides for local/offline validation.
# CHROMA_IMAGE=chromadb/chroma:latest
# NEO4J_IMAGE=neo4j:5.24
# REDIS_IMAGE=redis:7.4-alpine
USE_NEO4J=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
USE_CHROMA=true
CHROMA_MODE=remote
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8002
CHROMA_PERSIST_DIR=./storage/chromadb
CHROMA_COLLECTION=coderag_chunks
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=coderag_docs
POSTGRES_USER=coderag
POSTGRES_PASSWORD=coderag
USE_RQ=false
REDIS_URL=redis://localhost:6379/0
RQ_INGEST_JOB_TIMEOUT_SEC=900
